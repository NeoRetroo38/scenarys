{
  "name": "scenarys-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:public": "npm run build && node scripts/prepare-public-site.mjs",
    "test": "node --test scripts/public-site.test.mjs scripts/cube-interaction.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:sim": "vite build --mode simulation --base ./ --outDir ../simulacion/scenarys-build"
  },
  "dependencies": {
    "@neoretroo38/neo-cube-web": "github:NeoRetroo38/neo-cube-web#v0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  }
}
